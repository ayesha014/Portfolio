<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ayesha Shahid — Aspiring Software Engineer</title>
<meta name="description" content="Portfolio of Ayesha Shahid, aspiring software engineer.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Kalam:wght@400;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
<style>
  
  :root{
    --paper:      #FBF4E4;   
    --paper-alt:  #F4E8CC;   
    --ink:        #241E17;   
    --coral:      #FF5A3C;   
    --teal:       #1E8F87;   
    --mustard:    #FFC245;   
    --grape:      #8C63E0;   
    --cream-line: rgba(36,30,23,0.14);

    --card:        #FFFDF6;            
    --text-soft:   #4A4238;            
    --text-body:   #40382D;            
    --text-meta:   #6B6153;            
    --nav-bg:      rgba(251,244,228,0.85);
    --grain-dot:   rgba(36,30,23,0.09);
    --stripe:      rgba(36,30,23,0.08);
    --placeholder: rgba(36,30,23,0.35);
    --shadow-1:    rgba(36,30,23,0.12); 
    --shadow-2:    rgba(36,30,23,0.20); 
    --shadow-tape: rgba(36,30,23,0.15);

    --display: 'Anton', sans-serif;
    --hand:    'Kalam', cursive;
    --body:    'Inter', sans-serif;
    --mono:    'IBM Plex Mono', monospace;

    --max: 1140px;
    --edge: clamp(20px, 5vw, 64px);
  }

  
  html[data-theme="dark"]{
    --paper:      #1B1712;
    --paper-alt:  #241E17;
    --ink:        #F3ECDD;
    --coral:      #FF7A5C;
    --teal:       #3FC9C0;
    --mustard:    #FFD166;
    --grape:      #B08BFF;
    --cream-line: rgba(243,236,221,0.14);

    --card:        #2A241C;
    --text-soft:   #C9BFAE;
    --text-body:   #C2B8A6;
    --text-meta:   #9C8F79;
    --nav-bg:      rgba(20,17,13,0.85);
    --grain-dot:   rgba(243,236,221,0.055);
    --stripe:      rgba(243,236,221,0.06);
    --placeholder: rgba(243,236,221,0.3);
    --shadow-1:    rgba(0,0,0,0.35);
    --shadow-2:    rgba(0,0,0,0.5);
    --shadow-tape: rgba(0,0,0,0.4);
  }

  html{ transition: none; }
  body{ transition: background-color 0.3s ease, color 0.3s ease; }

  *{ box-sizing: border-box; }
  html{ scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce){
    html{ scroll-behavior: auto; }
    *{ animation-duration: 0.001ms !important; animation-iteration-count: 1 !important; transition-duration: 0.001ms !important; }
  }

  body{
    margin:0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--body);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  h1,h2,h3{ margin:0; }
  p{ margin:0; }
  a{ color: inherit; text-decoration: none; }
  .hand{ font-family: var(--hand); }
  .mono{ font-family: var(--mono); }
  ul{ list-style:none; margin:0; padding:0; }

  ::selection{ background: var(--mustard); color: var(--ink); }
  :focus-visible{ outline: 3px solid var(--teal); outline-offset: 3px; }

  
  .grain{
    position: fixed; inset:0; z-index:0; pointer-events:none;
    background-image: radial-gradient(var(--grain-dot) 1.2px, transparent 1.2px);
    background-size: 16px 16px;
    opacity: 0.55;
  }
  section, header, footer, nav{ position: relative; z-index: 1; }
  .wrap{ max-width: var(--max); margin:0 auto; padding: 0 var(--edge); }

  

  
  .torn{
    border-radius: 255px 12px 225px 12px / 12px 225px 12px 255px;
  }

  
  .tape{
    position:absolute;
    width: 84px; height: 26px;
    opacity: 0.8;
    box-shadow: 0 1px 2px var(--shadow-tape);
  }
  .tape::after{
    content:'';
    position:absolute; inset:0;
    background-image: repeating-linear-gradient(115deg, rgba(255,255,255,0.35) 0 3px, transparent 3px 7px);
  }
  .tape-coral{ background: var(--coral); }
  .tape-teal{ background: var(--teal); }
  .tape-mustard{ background: var(--mustard); }
  .tape-grape{ background: var(--grape); }

  
  .btn-stamp, .btn-outline-stamp{
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.02em;
    padding: 14px 26px;
    display: inline-flex;
    align-items:center;
    gap: 8px;
    border: 2.5px solid var(--ink);
    border-radius: 6px;
    transition: transform 0.15s ease, background 0.15s ease, color .15s ease;
    cursor: pointer;
    transform: rotate(-1deg);
  }
  .btn-stamp{ background: var(--coral); color: var(--paper); font-weight: 700; }
  .btn-stamp:hover{ transform: rotate(0deg) translateY(-3px); }
  .btn-outline-stamp{ background: transparent; }
  .btn-outline-stamp:hover{ background: var(--mustard); transform: rotate(1deg) translateY(-3px); }

  .doodle-underline{ display:block; margin-top: 6px; }

  .section-label{
    display:inline-block;
    font-family: var(--hand);
    font-size: 22px;
    color: var(--coral);
    transform: rotate(-2deg);
    margin-bottom: 10px;
  }

  .reveal{
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .reveal.is-visible{ opacity: 1; transform: translateY(0); }

  
  .nav{
    position: fixed; top:0; left:0; right:0; z-index: 50;
    display:flex; align-items:center; justify-content:space-between;
    padding: 16px var(--edge);
    background: var(--nav-bg);
    backdrop-filter: blur(8px);
    border-bottom: 2.5px dashed var(--ink);
  }
  .logo{ font-family: var(--display); font-size: 22px; letter-spacing: 0.02em; }
  .logo-dot{ color: var(--coral); }
  .nav-links{ display:flex; gap: 30px; font-family: var(--hand); font-size: 18px; }
  .nav-links a{ position:relative; }
  .nav-links a:hover{ color: var(--teal); }
  .nav-right{ display:flex; align-items:center; gap: 14px; }
  .theme-toggle{ font-size: 12px; padding: 10px 16px; white-space: nowrap; }
  @media (max-width: 780px){
    .nav-links{ display:none; }
    .theme-toggle{ font-size: 0; padding: 10px; width: 40px; height: 40px; justify-content:center; }
    .theme-toggle::before{ content: attr(data-icon); font-size: 16px; }
  }

  
  .hero{
    min-height: 100svh;
    display:flex; align-items:center;
    padding: 130px var(--edge) 70px;
  }
  .hero-inner{
    max-width: var(--max); margin:0 auto; width:100%;
    display:grid; grid-template-columns: 1.3fr 0.7fr; gap: 40px; align-items:center;
  }
  .eyebrow{ font-family: var(--hand); font-size: 20px; color: var(--teal); margin-bottom: 6px; transform: rotate(-1deg); display:inline-block; }
  .hero h1{
    font-family: var(--display);
    font-size: clamp(46px, 8vw, 96px);
    line-height: 0.95;
    letter-spacing: 0.01em;
  }
  .role-line{ margin-top: 18px; font-family: var(--hand); font-size: clamp(20px, 2.6vw, 28px); color: var(--ink); }
  .role-line span{ color: var(--coral); font-weight: 700; }
  .cursor{ display:inline-block; animation: blink 1s step-end infinite; color: var(--teal); }
  @keyframes blink{ 50%{ opacity: 0; } }

  .hero-desc{ margin-top: 20px; max-width: 520px; font-size: 17px; color: var(--text-soft); }
  .hero-actions{ margin-top: 34px; display:flex; gap: 16px; flex-wrap: wrap; }
  .status{
    margin-top: 40px; display:flex; align-items:center; gap: 10px;
    font-family: var(--mono); font-size: 12.5px; color: var(--text-soft);
  }
  .status-dot{ width: 9px; height: 9px; border-radius: 50%; background: var(--teal);
    box-shadow: 0 0 0 0 rgba(30,143,135,0.6); animation: pulse 2s infinite; }
  @keyframes pulse{
    0%{ box-shadow: 0 0 0 0 rgba(30,143,135,0.5); }
    70%{ box-shadow: 0 0 0 8px rgba(30,143,135,0); }
    100%{ box-shadow: 0 0 0 0 rgba(30,143,135,0); }
  }

  
  .polaroid{
    position: relative;
    background: var(--card);
    padding: 14px 14px 46px;
    box-shadow: 0 10px 24px var(--shadow-2);
    transform: rotate(6deg);
  }
  .polaroid-photo{
    aspect-ratio: 4/5;
    background:
      repeating-linear-gradient(135deg, var(--stripe) 0 2px, transparent 2px 14px),
      var(--paper-alt);
    display:flex; align-items:center; justify-content:center;
    color: var(--placeholder);
    font-family: var(--display);
    font-size: 54px;
  }
  .polaroid-caption{
    position:absolute; bottom: 10px; left: 0; right:0; text-align:center;
    font-family: var(--hand); font-size: 16px; color: var(--ink);
  }
  .polaroid .tape{ top: -14px; left: 50%; transform: translateX(-50%) rotate(-4deg); }

  
  .polaroid-photo svg{ width: 74%; height: 74%; overflow: visible; }
  .illo-ink{ stroke: var(--ink); }
  .illo-fill-ink{ fill: var(--ink); }

  
  .illo-line{ transform-origin: left center; animation: typeGrow 3.2s ease-in-out infinite; }
  .illo-line:nth-child(1){ animation-delay: 0s; }
  .illo-line:nth-child(2){ animation-delay: 0.5s; }
  .illo-line:nth-child(3){ animation-delay: 1s; }
  @keyframes typeGrow{
    0%, 8%{ transform: scaleX(0); }
    38%, 62%{ transform: scaleX(1); }
    92%,100%{ transform: scaleX(0); }
  }
  .illo-cursor{ animation: blink 0.9s step-end infinite; }
  .illo-steam{ animation: steamRise 2.8s ease-in infinite; opacity: 0; }
  .illo-steam:nth-child(1){ animation-delay: 0s; }
  .illo-steam:nth-child(2){ animation-delay: 0.9s; }
  .illo-steam:nth-child(3){ animation-delay: 1.8s; }
  @keyframes steamRise{
    0%{ transform: translateY(0) scale(1); opacity: 0; }
    20%{ opacity: 0.8; }
    100%{ transform: translateY(-16px) scale(1.25); opacity: 0; }
  }

  
  .illo-gear{ transform-origin: center; animation: gearSpin 6s linear infinite; }
  @keyframes gearSpin{ to{ transform: rotate(360deg); } }
  .illo-bulb-glow{ animation: bulbPulse 2.4s ease-in-out infinite; transform-origin: center; }
  @keyframes bulbPulse{
    0%,100%{ opacity: 0.25; transform: scale(0.9); }
    50%{ opacity: 0.9; transform: scale(1.15); }
  }

  
  .illo-scan{ animation: scanMove 2.6s ease-in-out infinite alternate; }
  @keyframes scanMove{
    0%{ transform: translateY(-14px); }
    100%{ transform: translateY(14px); }
  }
  .illo-plate-box{ animation: plateBlink 1.8s ease-in-out infinite; transform-origin: center; }
  @keyframes plateBlink{
    0%,100%{ opacity: 0.35; }
    50%{ opacity: 1; }
  }

  
  .illo-heart{ animation: heartbeatPulse 1.6s ease-in-out infinite; transform-origin: center; }
  @keyframes heartbeatPulse{
    0%,100%{ transform: scale(1); }
    18%{ transform: scale(1.18); }
    32%{ transform: scale(1); }
  }
  .illo-ekg{ stroke-dasharray: 10 6; animation: ekgMove 1.4s linear infinite; }
  @keyframes ekgMove{ to{ stroke-dashoffset: -160; } }

  
  .illo-dot{ animation: dotTravel 2.4s ease-in-out infinite; opacity: 0; }
  .illo-dot:nth-child(1){ animation-delay: 0s; }
  .illo-dot:nth-child(2){ animation-delay: 0.6s; }
  .illo-dot:nth-child(3){ animation-delay: 1.2s; }
  @keyframes dotTravel{
    0%{ transform: translateX(0); opacity: 0; }
    15%{ opacity: 1; }
    85%{ opacity: 1; }
    100%{ transform: translateX(46px); opacity: 0; }
  }
  .illo-tail{ animation: tailWag 1.2s ease-in-out infinite; transform-origin: 20% 50%; }
  @keyframes tailWag{
    0%,100%{ transform: rotate(-8deg); }
    50%{ transform: rotate(10deg); }
  }

  .scroll-cue{ position:absolute; bottom: 26px; left: var(--edge); font-family: var(--hand); font-size: 16px; color: var(--ink); }

  @media (max-width: 860px){
    .hero-inner{ grid-template-columns: 1fr; }
    .polaroid{ max-width: 220px; margin: 0 auto; transform: rotate(3deg); }
  }

  
  .about{ padding: 110px 0; }
  .about-grid{ display:grid; grid-template-columns: 320px 1fr; gap: 56px; align-items:start; }
  .about .polaroid{ transform: rotate(-5deg); }
  .about .polaroid .tape{ background: var(--mustard); }
  .about .polaroid .tape::after{ background-image: repeating-linear-gradient(115deg, rgba(255,255,255,0.35) 0 3px, transparent 3px 7px); }

  .about-copy h2{
    font-family: var(--display);
    font-size: clamp(28px, 3.8vw, 42px);
    max-width: 14ch;
    margin-bottom: 20px;
    line-height: 1.05;
  }
  .about-copy p{ margin-bottom: 16px; color: var(--text-body); max-width: 62ch; }
  .about-meta{ margin-top: 30px; display:flex; flex-wrap:wrap; gap: 14px; }
  .meta-tag{
    font-family: var(--hand); font-size: 16px;
    background: var(--paper-alt);
    border: 2px solid var(--ink);
    border-radius: 999px;
    padding: 8px 18px;
    transform: rotate(-1.5deg);
  }
  .meta-tag:nth-child(2n){ transform: rotate(1.5deg); }
  .meta-tag b{ color: var(--coral); }

  @media (max-width: 780px){
    .about-grid{ grid-template-columns: 1fr; }
    .about .polaroid{ max-width: 220px; margin: 0 auto; }
  }

  
  .skills{ padding: 110px 0; background: var(--paper-alt); }
  .skills h2{ font-family: var(--display); font-size: clamp(30px, 4vw, 46px); margin-bottom: 50px; max-width: 16ch; }
  .spec-grid{ display:grid; grid-template-columns: repeat(2, 1fr); gap: 34px 28px; }
  .spec-card{
    position:relative;
    background: var(--card);
    padding: 30px 26px 26px;
    box-shadow: 0 8px 18px var(--shadow-1);
  }
  .spec-card:nth-child(1){ transform: rotate(-1.4deg); }
  .spec-card:nth-child(2){ transform: rotate(1.2deg); }
  .spec-card:nth-child(3){ transform: rotate(1deg); }
  .spec-card:nth-child(4){ transform: rotate(-1deg); }
  .spec-card .tape{ top: -14px; left: 24px; }
  .spec-card h3{
    font-family: var(--hand); font-weight: 700; font-size: 24px;
    margin-bottom: 16px; color: var(--ink);
  }
  .chip-row{ display:flex; flex-wrap:wrap; gap: 10px; }
  .chip{
    font-family: var(--mono); font-size: 12.5px;
    padding: 7px 12px;
    border: 1.5px dashed var(--ink);
    border-radius: 4px;
    color: var(--text-body);
    background: var(--paper);
  }
  @media (max-width: 780px){
    .spec-grid{ grid-template-columns: 1fr; }
    .spec-card{ transform: none !important; }
  }

  
  .education{ padding: 110px 0; }
  .education h2{ font-family: var(--display); font-size: clamp(30px, 4vw, 46px); margin-bottom: 50px; max-width: 16ch; }
  .edu-grid{ display:grid; grid-template-columns: repeat(2, 1fr); gap: 28px; }
  .edu-card{
    position:relative;
    background: var(--card);
    padding: 28px 26px 24px;
    box-shadow: 0 8px 18px var(--shadow-1);
  }
  .edu-card:nth-child(1){ transform: rotate(-1.2deg); }
  .edu-card:nth-child(2){ transform: rotate(1deg); }
  .edu-card .tape{ top: -14px; left: 24px; }
  .edu-card .edu-degree{ font-family: var(--display); font-size: 19px; margin-bottom: 6px; }
  .edu-card .edu-school{ font-family: var(--hand); font-size: 17px; color: var(--teal); margin-bottom: 4px; }
  .edu-card .edu-dates{ font-family: var(--mono); font-size: 12px; color: var(--text-meta); margin-bottom: 12px; }
  .edu-card .edu-grade{ display:inline-block; font-family: var(--mono); font-size: 12px; border: 1.5px dashed var(--ink); border-radius: 4px; padding: 5px 10px; }
  @media (max-width: 780px){
    .edu-grid{ grid-template-columns: 1fr; }
    .edu-card{ transform: none !important; }
  }

  
  .experience{ padding: 110px 0; background: var(--paper-alt); }
  .experience h2{ font-family: var(--display); font-size: clamp(30px, 4vw, 46px); margin-bottom: 50px; max-width: 18ch; }
  .timeline{ display:flex; flex-direction:column; gap: 26px; }
  .exp-card{
    position:relative;
    background: var(--card);
    padding: 26px 28px;
    box-shadow: 0 8px 18px var(--shadow-1);
  }
  .exp-card:nth-child(odd){ transform: rotate(-0.7deg); }
  .exp-card:nth-child(even){ transform: rotate(0.6deg); }
  .exp-card .tape{ top: -14px; left: 32px; }
  .exp-head{ display:flex; flex-wrap:wrap; justify-content:space-between; align-items:baseline; gap: 10px; margin-bottom: 14px; }
  .exp-role{ font-family: var(--display); font-size: 19px; }
  .exp-org{ font-family: var(--hand); font-size: 17px; color: var(--coral); }
  .exp-dates{ font-family: var(--mono); font-size: 12px; color: var(--text-meta); }
  .exp-card ul{ display:flex; flex-direction:column; gap: 8px; }
  .exp-card li{ font-size: 14.5px; color: var(--text-body); padding-left: 18px; position:relative; }
  .exp-card li::before{ content:'✦'; position:absolute; left:0; color: var(--teal); font-size: 11px; top: 4px; }
  @media (max-width: 780px){ .exp-card{ transform: none !important; } }

  
  .projects{ padding: 110px 0; }
  .projects h2{ font-family: var(--display); font-size: clamp(30px, 4vw, 46px); margin-bottom: 54px; max-width: 16ch; }
  .project-card{
    position: relative;
    display:grid; grid-template-columns: 300px 1fr; gap: 36px;
    align-items: center;
    margin-bottom: 64px;
  }
  .project-card:nth-child(even){ grid-template-columns: 1fr 300px; }
  .project-card:nth-child(even) .project-media{ order: 2; }
  .project-media .polaroid{ transform: rotate(-4deg); }
  .project-card:nth-child(2n) .project-media .polaroid{ transform: rotate(4deg); }
  .project-media .polaroid .tape{ background: var(--grape); }
  .project-thumb{
    font-family: var(--display); font-size: 13px; letter-spacing: 0.06em;
  }
  .project-meta{ display:flex; gap: 14px; flex-wrap:wrap; font-family: var(--mono); font-size: 11.5px; color: var(--teal); margin-bottom: 14px; }
  .project-meta span{ background: var(--paper-alt); padding: 4px 10px; border-radius: 4px; }
  .project-body h3{ font-family: var(--display); font-size: 26px; margin-bottom: 12px; }
  .project-body p{ color: var(--text-body); margin-bottom: 20px; max-width: 52ch; }
  .project-links{ display:flex; gap: 22px; }
  .project-links a{
    font-family: var(--hand); font-size: 17px; color: var(--coral);
    border-bottom: 2px dashed var(--coral);
  }
  .project-links a:hover{ color: var(--teal); border-color: var(--teal); }

  @media (max-width: 780px){
    .project-card, .project-card:nth-child(even){ grid-template-columns: 1fr; }
    .project-card:nth-child(even) .project-media{ order: 0; }
    .project-media .polaroid{ max-width: 220px; margin: 0 auto; }
  }

  
  .contact{ padding: 110px 0 90px; background: var(--paper-alt); }
  .contact-inner{ text-align:center; max-width: 720px; margin: 0 auto; }
  .contact h2{ font-family: var(--display); font-size: clamp(30px, 4.4vw, 50px); margin-bottom: 44px; }
  .postcard{
    position:relative;
    background: var(--card);
    border: 2.5px solid var(--ink);
    border-radius: 10px;
    padding: 34px 30px;
    text-align:left;
    box-shadow: 0 10px 24px var(--shadow-tape);
    transform: rotate(-1deg);
    margin-bottom: 40px;
  }
  .postcard .tape{ top: -14px; right: 40px; }
  .postcard-row{ display:flex; justify-content:space-between; align-items:center; padding: 10px 0; border-bottom: 1.5px dashed var(--cream-line); font-family: var(--mono); font-size: 14px; }
  .postcard-row:last-child{ border-bottom:none; }
  .postcard-row a:hover{ color: var(--teal); }
  .stamp{
    position:absolute; top: 18px; right: 18px;
    width: 58px; height: 58px;
    border: 2.5px dashed var(--coral);
    border-radius: 6px;
    display:flex; align-items:center; justify-content:center;
    font-family: var(--hand); color: var(--coral); font-size: 12px; text-align:center; line-height:1.2;
    transform: rotate(6deg);
  }
  .btn-stamp.big{ font-size: 16px; padding: 18px 36px; }

  
  footer{
    padding: 30px var(--edge) 40px; text-align:center;
    font-family: var(--hand); font-size: 15px; color: var(--text-soft);
    border-top: 2.5px dashed var(--ink);
  }
</style>
</head>
<body>

<div class="grain" aria-hidden="true"></div>

<nav class="nav">
  <a href="#top" class="logo">AS<span class="logo-dot">.</span></a>
  <ul class="nav-links">
    <li><a href="#about">About</a></li>
    <li><a href="#skills">Skills</a></li>
    <li><a href="#education">Education</a></li>
    <li><a href="#experience">Experience</a></li>
    <li><a href="#projects">Projects</a></li>
    <li><a href="#contact">Contact</a></li>
  </ul>
  <div class="nav-right">
    <button id="themeToggle" class="btn-outline-stamp theme-toggle" type="button" aria-label="Toggle dark mode" data-icon="🌙">🌙 dark mode</button>
    <a class="btn-outline-stamp" href="#contact">Let's talk</a>
  </div>
</nav>

<header class="hero" id="top">
  <div class="hero-inner">
